<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true" />

        <service id="sylius.state_processor.locator" class="Sylius\Bundle\ResourceBundle\State\CallableProcessor" public="false">
            <argument type="tagged_locator" tag="sylius.state_processor" />
        </service>
        <service id="sylius.state_processor" alias="sylius.state_processor.locator" />

        <service id="Sylius\Bundle\ResourceBundle\Doctrine\State\RemoveProcessor" class="Sylius\Bundle\ResourceBundle\Doctrine\State\RemoveProcessor" public="false">
            <argument type="service" id="doctrine" />

            <tag name="sylius.state_processor" priority="-100" />
        </service>

        <service id="Sylius\Bundle\ResourceBundle\Doctrine\State\PersistProcessor" class="Sylius\Bundle\ResourceBundle\Doctrine\State\PersistProcessor" public="false">
            <argument type="service" id="doctrine" />

            <tag name="sylius.state_processor" priority="-100" />
        </service>
    </services>
</container>
